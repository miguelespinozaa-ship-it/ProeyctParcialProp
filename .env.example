# ---- MySQL (MS1) ----
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ms1_usuarios
MYSQL_USER=ms1_user
MYSQL_PASSWORD=ms1_password

# ---- PostgreSQL (MS3) ----
POSTGRES_DB=ms3_pedidos
POSTGRES_USER=ms3_user
POSTGRES_PASSWORD=ms3_password

# ---- MongoDB (MS2) ----
MONGO_URI=mongodb://mongo:27017/ms2_catalogo

# ---- Auth compartido ----
# HS256 exige >= 32 bytes; MS1 (python-jose) y MS2 (jjwt) firman/validan con el mismo secreto.
JWT_SECRET=change-me-in-prod-use-a-long-random-secret-32-bytes-min
JWT_EXPIRE_MINUTES=60

# ---- Solo EC2 #1 (docker-compose.app.yml): IP privada de EC2 #2 ----
DB_HOST=localhost

# ---- MS5 / AWS Athena ----
# true (default) = endpoints devuelven datos de ejemplo, sin pegarle a AWS (Fase 8, antes del pipeline de Fase 9).
# Poner en false + credenciales reales recién en Fase 9/10, cuando Glue/Athena estén poblados.
ATHENA_MOCK=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ATHENA_DATABASE=ubereats_datalake
ATHENA_OUTPUT_S3=s3://ubereats-datalake-utec/athena-results/
