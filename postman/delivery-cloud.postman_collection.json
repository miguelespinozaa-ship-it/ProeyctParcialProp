    {
      "name": "MS1 - Usuarios/Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ms1/api/v1/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ms1",
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test Postman\",\n  \"email\": \"postman{{$timestamp}}@demo.com\",\n  \"password\": \"pass123\",\n  \"telefono\": \"999000111\",\n  \"rol\": \"customer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"token_customer\", j.token);",
                  "pm.collectionVariables.set(\"customer_id\", j.id);",
                  "pm.test(\"201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register admin (debe dar 400)",
