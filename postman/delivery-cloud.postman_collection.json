        {
          "name": "Login customer (demo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ms1/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ms1",
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@demo.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"token_customer\", j.access_token);",
                  "const p = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/')));",
                  "pm.collectionVariables.set(\"customer_id\", p.sub);",
                  "pm.test(\"login ok\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
