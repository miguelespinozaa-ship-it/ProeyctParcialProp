gn=middle;fontSize=12;fontFamily=Courier New;fontColor=#5F6B7A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="762.0" y="216" width="190.00000000000003" height="26" as="geometry"/></mxCell><mxCell id="c52" value="" style="html=1;fillColor=#F6F7F9;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="601" y="242" width="358" height="26" as="geometry"/></mxCell><mxCell id="c53" value="" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=11;fontColor=#5F6B7A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="604" y="242" width="40" height="26" as="geometry"/></mxCell><mxCell id="c54" value="precio_unitario" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="644" y="242" width="180.0" height="26" as="geometry"/></mxCell><mxCell id="c55" value="NUMERIC(10,2)" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontFamily=Courier New;fontColor=#5F6B7A;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="762.0" y="242" width="190.00000000000003" height="26" as="geometry"/></mxCell><mxCell id="c56" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.8;startArrow=ERmandOne;startFill=0;endArrow=ERmany;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="125.0" as="sourcePoint"/><mxPoint x="600" y="151.0" as="targetPoint"/><Array as="points"><mxPoint x="520" y="125.0"/><mxPoint x="520" y="151.0"/></Array></mxGeometry></mxCell><mxCell id="c57" value="1 : N" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=13;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;opacity=90;" vertex="1" parent="1"><mxGeometry x="496.125" y="106.25" width="47.75" height="22.2" as="geometry"/></mxCell><mxCell id="c58" value="ON DELETE CASCADE" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=nowrap;fontSize=11;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="460.575" y="170.0" width="118.85000000000001" height="21.4" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Reglas del modelo&lt;/b&gt;&lt;br&gt;• Un pedido tiene de 1 a N ítems (orders 1 : N order_items). Al crearse, MS3 valida cada plato contra MS2 y guarda&lt;br&gt;&amp;nbsp;&amp;nbsp;nombre y precio unitario como fotografía del momento de la compra.&lt;br&gt;• status ∈ {PEDIDO, ENVIADO, ENTREGADO}: PEDIDO → ENVIADO (admin del restaurante) → ENTREGADO (repartidor asignado).&lt;br&gt;• customer_id / delivery_id (MySQL) y restaurant_id (MongoDB) son referencias lógicas entre microservicios, sin FK.&lt;br&gt;• Índices: idx_orders_customer, idx_orders_restaurant(restaurant_id, status), idx_orders_delivery, idx_order_items_order.&lt;br&gt;• Carga masiva única con seed.js: 20,000+ pedidos con sus ítems." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBE6;strokeColor=#D6B656;strokeWidth=1.6;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="336" width="920" height="168" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="JSON MongoDB (MS2)" id="JSON MongoDB (MS2)"><mxGraphModel dx="1260" dy="720" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Estructura JSON — MS2 Catálogo de Restaurantes · MongoDB 7 · colección ms2_catalogo.restaurantes" style="text;html=0;fontSize=20;fontStyle=1;fontColor=#232F3E;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="1212" height="34" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;arcSize=3;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=1.8;" vertex="1" parent="1">