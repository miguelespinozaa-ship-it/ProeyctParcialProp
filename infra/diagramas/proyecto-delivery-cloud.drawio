ign=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;opacity=90;" vertex="1" parent="1"><mxGeometry x="1122.825" y="924.75" width="54.35" height="19.4" as="geometry"/></mxCell><mxCell id="c66" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.8;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="950" as="sourcePoint"/><mxPoint x="780" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c67" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.8;dashed=1;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1010" as="sourcePoint"/><mxPoint x="1645" y="1010" as="targetPoint"/><Array as="points"><mxPoint x="985" y="1100"/><mxPoint x="1645" y="1100"/></Array></mxGeometry></mxCell><mxCell id="c68" value="lee los archivos" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;opacity=90;" vertex="1" parent="1"><mxGeometry x="1260.6" y="1076.75" width="108.80000000000001" height="19.4" as="geometry"/></mxCell><mxCell id="c69" style="edgeStyle=none;html=1;rounded=0;strokeColor=#232F3E;strokeWidth=1.8;startArrow=none;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="800" as="sourcePoint"/><mxPoint x="985" y="890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="MS5 · boto3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=none;opacity=90;" vertex="1" parent="1"><mxGeometry x="1005.725" y="836.75" width="78.55000000000001" height="19.4" as="geometry"/></mxCell><mxCell id="c71" value="Seguridad y operación" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#5F6B7A;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#5F6B7A;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="430" height="300" as="geometry"/></mxCell><mxCell id="c72" value="• ALB: solo acepta tráfico del VPC Link (SG propio).&lt;br&gt;• App Tier: puerto 80 desde el ALB; sin SSH público&lt;br&gt;&amp;nbsp;&amp;nbsp;(administración con AWS Systems Manager).&lt;br&gt;• DB Tier: 3306 / 5432 / 27017 solo desde el SG de&lt;br&gt;&amp;nbsp;&amp;nbsp;App e Ingesta; sin puertos abiertos a internet.&lt;br&gt;• Roles IAM: LabInstanceProfile en las EC2&lt;br&gt;&amp;nbsp;&amp;nbsp;(S3, Athena, Glue, SSM); sin claves en el código.&lt;br&gt;• JWT HS256 compartido entre MS1, MS2 y MS3;&lt;br&gt;&amp;nbsp;&amp;nbsp;MS4 reenvía el token del usuario.&lt;br&gt;• Health check del ALB cada 15 s: si una VM cae,&lt;br&gt;&amp;nbsp;&amp;nbsp;la otra atiende todo el tráfico." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=nowrap;fontSize=12.5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="36" y="637.5" width="373.50000000000006" height="198.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>